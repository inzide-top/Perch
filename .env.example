# API 服务
PORT=8787
API_HOST=127.0.0.1
# 仅供一键本地启动脚本读取；local 固定 5173，auth 固定 5174。
WEB_PORT=5173

# 身份模式：本地开发使用 development；共享面试体验使用 interview；正式多用户环境使用 supabase。
AUTH_MODE=development
VITE_AUTH_MODE=development
# development 与 interview 模式使用的固定数据身份；正式模式忽略这两项。
DEVELOPMENT_USER_ID=demo-user
INTERVIEW_DEMO_USER_ID=interview-demo-user
# 正式登录的 Supabase Auth 项目。Publishable Key 可以出现在浏览器配置中，但不要填写 service_role key。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL / Supabase 连接。线上必须替换密码并启用对应 SSL 策略。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_seek_employment
DATABASE_SSL=disable
DATABASE_POOL_SIZE=3

# 浏览器端只允许放公开配置，禁止在任何 VITE_ 变量中填写模型或第三方服务密钥。
# 前端开发服务器请求 API 的地址。
VITE_API_BASE_URL=http://127.0.0.1:8787/api
# 多个来源使用逗号分隔；生产环境必须替换为实际前端域名。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 本地双模式建议：
# 1. 通用密钥和数据库配置保留在 .env。
# 2. development 模式覆盖项放在 .env.development.local。
# 3. Supabase 登录测试覆盖项放在 .env.auth.local。
# 两个 *.local 文件均被 Git 忽略，分别通过 pnpm dev:local 和 pnpm dev:auth 启动。

# 可观测性
# 开启后记录接口响应字节、数据库查询次数和关键读路径耗时。
API_METRICS_ENABLED=false

# 开发者调试台：后端必须显式开启；前端本地开发缺省开启、生产构建缺省关闭。
ENABLE_DEVELOPER_TOOLS=true
VITE_ENABLE_DEVELOPER_TOOLS=true

# 岗位网页导入。密钥只由服务端读取，不要使用 VITE_ 前缀。
# Firecrawl 服务端密钥，仅用于从公开岗位网页生成导入预览；留空时关闭网页导入。
FIRECRAWL_API_KEY=

# RAG / Embedding
# 平台统一提供的 OpenAI-compatible Embedding 服务；第一版固定要求输出 1024 维向量。
# 三项全部留空时关闭历史会话语义检索；启用时必须同时填写。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 仅影响离线 RAG 评测脚本的请求批次，不影响线上聊天检索。
RAG_EVAL_EMBEDDING_BATCH_SIZE=8
