{
  "name": "agent-seek-employment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "db:check": "tsx server/src/db/check-connection.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:core": "tsx --tsconfig server/tsconfig.json --test server/src/services/opportunity-fingerprint.test.ts server/src/services/job-analysis/prompt.test.ts server/src/services/analysis-presentation.test.ts",
    "typecheck": "vue-tsc -b",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@nuxt/ui": "^4.10.0",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
